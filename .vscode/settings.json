{
  "files.associations": { "*.luau": "luau" },
  "[luau]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
    "editor.formatOnSave": true,
    "editor.insertSpaces": false,
    "editor.tabSize": 4
  },
  "luau-lsp.platform.type": "roblox",
  "luau-lsp.sourcemap.enabled": true,
  "luau-lsp.sourcemap.autogenerate": false,
  "luau-lsp.sourcemap.rojoProjectFile": "default.project.json",
  "luau-lsp.sourcemap.includeNonScripts": true,
  "luau-lsp.diagnostics.strictDatamodelTypes": true,
  "terminal.integrated.env.linux": {
    "PATH": "${workspaceFolder}/.tools/bin:${env:HOME}/.rokit/bin:${env:PATH}"
  },
  "files.exclude": { "**/.tools": true, "**/.codegraph": true, "**/graphify-out": true },
  "search.exclude": { "**/build": true, "**/.tools": true, "**/graphify-out": true }
}
